# Lockstep needs NO API keys or secrets. Every value below is the default.
# Optional: cp .env.example .env, then edit .env (git-ignored). run.sh loads it.

# Port for the web server (dashboard + API + WebSocket)
PORT=8000
# Start mode: replay (default) or live
LOCKSTEP_MODE=replay
# SQLite file for snapshots and alerts (falls back to memory if it can't be opened)
LOCKSTEP_DB=data/lockstep.db
# Binance public market-data endpoints (no key required)
LOCKSTEP_REST=https://data-api.binance.vision
LOCKSTEP_WS=wss://data-stream.binance.vision